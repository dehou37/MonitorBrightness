
<Window x:Class="MonitorBrightness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Brightness"
        Height="350"
        Width="420"
        MinHeight="320"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Monitor"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ComboBox x:Name="MonitorList"
                  Grid.Row="1"
                  Height="32"
                  DisplayMemberPath="Name"
                  SelectionChanged="MonitorList_SelectionChanged"/>

        <Grid Grid.Row="2" Margin="0,22,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Brightness"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="BrightnessLabel"
                       Grid.Column="1"
                       Text="50%"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <Slider x:Name="BrightnessSlider"
                Grid.Row="3"
                Minimum="0"
                Maximum="100"
                Value="50"
                TickFrequency="5"
                IsSnapToTickEnabled="False"
                ValueChanged="BrightnessSlider_ValueChanged"/>

        <StackPanel Grid.Row="4" Margin="0,22,0,0">
            <TextBlock Text="Presets"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <UniformGrid Columns="4">
                <Button Content="25%"
                        Tag="25"
                        Margin="2"
                        Padding="6"
                        Click="Preset_Click"/>

                <Button Content="50%"
                        Tag="50"
                        Margin="2"
                        Padding="6"
                        Click="Preset_Click"/>

                <Button Content="75%"
                        Tag="75"
                        Margin="2"
                        Padding="6"
                        Click="Preset_Click"/>

                <Button Content="100%"
                        Tag="100"
                        Margin="2"
                        Padding="6"
                        Click="Preset_Click"/>
            </UniformGrid>

            <TextBlock Text="Shortcuts: Ctrl + Alt + J (−5%) | Ctrl + Alt + K (+5%)"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,16,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Text="Ready"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
